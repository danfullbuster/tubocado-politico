# Copia este archivo como .env y rellena los valores reales

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/tbp?retryWrites=true&w=majority

# Secreto para las sesiones (genera algo largo y aleatorio)
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Puerto (Railway lo asigna automáticamente)
PORT=3000

# Contraseñas iniciales de admin (solo se usan la primera vez al arrancar)
ADMIN_PASSWORD_NATI=tu-password-seguro-aqui
ADMIN_PASSWORD_ANDRE=tu-password-seguro-aqui
